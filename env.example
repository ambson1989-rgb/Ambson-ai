# --- Instagram (Instagram API with Instagram Login) ---
IG_USER_ID=                    # numeric ID from the OAuth flow
IG_ACCESS_TOKEN=                # long-lived Instagram User access token
IG_GRAPH_HOST=https://graph.instagram.com
IG_API_VERSION=v23.0

# --- Gemini (used for safety gate + comment replies; free tier) ---
GEMINI_API_KEY=

# --- Video generation (pick one provider, fill in the matching key) ---
VIDEO_GEN_PROVIDER=replicate    # replicate | runway | other
REPLICATE_API_TOKEN=

# --- Where generated videos are hosted before publishing ---
# Instagram's API pulls the video from a public URL at publish time.
# Point this at wherever you upload rendered clips (S3 bucket, Cloudflare R2, etc.)
PUBLIC_MEDIA_BASE_URL=https://your-bucket.example.com/reels/

# --- Optional: your affiliate/link-in-bio tracking base, for caption CTAs ---
AFFILIATE_LINK=
