# --- Instagram (Instagram API with Instagram Login) ---
IG_USER_ID=                    # numeric ID from the OAuth flow
IG_ACCESS_TOKEN=               # long-lived Instagram User access token (~60 days)
IG_GRAPH_HOST=https://graph.instagram.com
IG_API_VERSION=v23.0

# --- Gemini (safety gate + comment replies; free tier is fine for this volume) ---
GEMINI_API_KEY=

# --- Public media hosting (S3-compatible: Cloudflare R2 / AWS S3 / Backblaze B2) ---
# Instagram pulls the video from a public HTTPS URL at publish time.
PUBLIC_MEDIA_BUCKET=           # e.g. ambson-reels
PUBLIC_MEDIA_ACCESS_KEY=       # R2/S3 access key id
PUBLIC_MEDIA_SECRET_KEY=       # R2/S3 secret access key
PUBLIC_MEDIA_BASE_URL=         # public URL that serves objects, e.g. https://pub-xxxxx.r2.dev
PUBLIC_MEDIA_ENDPOINT=         # required for R2/B2, e.g. https://<ACCOUNT_ID>.r2.cloudflarestorage.com
PUBLIC_MEDIA_REGION=auto       # "auto" for R2; e.g. us-east-1 for AWS
PUBLIC_MEDIA_PREFIX=reels/     # object key prefix

# --- Optional: auto-update IG_ACCESS_TOKEN secret from token_refresh.py ---
# Create a classic PAT with "repo" + ability to manage secrets, store as GH_PAT.
GH_PAT=

# --- Optional: Discord/Slack incoming webhook for success/failure alerts ---
NOTIFY_WEBHOOK_URL=

# --- Optional: affiliate / link-in-bio tracking base for caption CTAs ---
AFFILIATE_LINK=

# --- Optional: set to 0 to keep local renders/ for debugging ---
CLEANUP_RENDERS=1
