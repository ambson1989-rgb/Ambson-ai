# --- Instagram (Instagram API with Instagram Login) ---
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_GRAPH_HOST=https://graph.instagram.com
IG_API_VERSION=v23.0

# --- Gemini (safety gate + comment replies) ---
GEMINI_API_KEY=

# --- Pollinations (images) — free key recommended ---
# Sign up: https://enter.pollinations.ai
# Without this, Flux requests often return HTTP 402.
POLLINATIONS_API_KEY=
# Optional: force a model name (flux, turbo, etc.)
POLLINATIONS_MODEL=

# --- Public media hosting (Cloudflare R2 / S3 / B2) ---
PUBLIC_MEDIA_BUCKET=
PUBLIC_MEDIA_ACCESS_KEY=
PUBLIC_MEDIA_SECRET_KEY=
PUBLIC_MEDIA_BASE_URL=
PUBLIC_MEDIA_ENDPOINT=
PUBLIC_MEDIA_REGION=auto
PUBLIC_MEDIA_PREFIX=reels/

# --- Optional ---
GH_PAT=
NOTIFY_WEBHOOK_URL=
AFFILIATE_LINK=
CLEANUP_RENDERS=1
